<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A music player's microSD card synced by Summit on the Mac (data/Card.kt): Summit/library.json and the music. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Updates over Wi-Fi from the Mac (data/Updater.kt). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Home screen mode: the other apps, listed in Settings › Apps. -->
    <queries><intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent></queries>
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Cleartext is for the Mac over USB (adb reverse) or a Tailscale IP: both stay on your own devices. -->
    <application
        android:name=".SummitApp"
        android:label="Summit"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Summit"
        android:usesCleartextTraffic="true">
        <!-- Lets `simpleperf` / Android Studio profile the release build on the device (no debugger, no slowdown). -->
        <profileable android:shell="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Can be the home screen (the JM21 boots into Summit); pick it in Android's Default apps › Home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Hardware / Bluetooth play button with the app closed: resumes the last queue (PlaybackService.Resume). -->
        <receiver android:name=".data.InstallReceiver" android:exported="false" />
        <receiver android:name="androidx.media3.session.MediaButtonReceiver" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MEDIA_BUTTON" /></intent-filter>
        </receiver>
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
